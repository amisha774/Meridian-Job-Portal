# Server & Database
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/meridian_job_portal
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Cloudinary File Uploads (Optional - falls back to local /uploads storage if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications via Nodemailer (Optional - logs cleanly in dev if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Meridian Careers <noreply@meridian.io>"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
